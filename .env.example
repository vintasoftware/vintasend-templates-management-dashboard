# Auth provider selection: clerk or auth0
AUTH_PROVIDER=clerk

# Clerk configuration (required when AUTH_PROVIDER=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Auth0 v4 configuration (required when AUTH_PROVIDER=auth0)
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# VintaSend templates-management API
# (https://github.com/vintasoftware/vintasend-ts-templates-management-api).
# The dashboard reads and writes every template and tag through this API; it
# never talks to a template backend directly. The key is server-side only and is
# added by app/api/templates/[...path]/route.ts, never sent to the browser.
TEMPLATES_API_URL=http://localhost:3334
TEMPLATES_API_KEY=
