import { fileURLToPath } from 'node:url';
import react from '@vitejs/plugin-react';
import { configDefaults, defineConfig } from 'vitest/config';

// Pin the timezone before any worker boots. Several components format dates for
// display, so without this the suite passes locally and fails on UTC CI (or the
// reverse) purely on the developer's machine settings. Workers are forked from
// this process, so they inherit it.
process.env.TZ = 'UTC';

const rootDir = fileURLToPath(new URL('./', import.meta.url));

export default defineConfig({
  plugins: [react()],

  resolve: {
    alias: [{ find: /^@\//, replacement: rootDir }],

    // The core declares `react` and `next` as peer dependencies but installs
    // its own copies as devDependencies. Once it is linked from the sibling
    // directory — `npm link`, or the `file:` specs that the repo-wide local
    // check script writes — its imports would resolve out of the core's
    // node_modules instead of ours. That yields a second React whose hook
    // dispatcher is always null, and a second `next/navigation` that the
    // suites' `vi.mock('next/navigation')` never intercepts. The same split
    // hits `@tanstack/react-query`, whose provider context the core's copy
    // cannot see. Dedupe every peer dependency the core declares so the app
    // and the core share one instance of each.
    dedupe: ['react', 'react-dom', 'next', '@tanstack/react-query'],
  },

  test: {
    globals: true,
    environment: 'jsdom',
    environmentOptions: {
      // Jest's jsdom default; `__tests__/support` builds API URLs against it.
      jsdom: { url: 'http://localhost/' },
    },
    setupFiles: ['./vitest.setup.ts'],

    include: ['**/__tests__/**/*.test.{ts,tsx}'],
    exclude: [...configDefaults.exclude, '.next/**', 'coverage/**'],

    // Vitest's jsdom environment keeps Node's own `fetch`, `Request`,
    // `Response`, `Headers`, `AbortController` and `AbortSignal` in place (it
    // only layers jsdom's DOM classes over them), so the fetch stack that
    // `openapi-fetch` and TanStack Query use comes from a single realm without
    // a custom environment.

    server: {
      deps: {
        // vintasend-templates-management-dashboard-core is published as ESM
        // only and would otherwise be loaded by Node directly, out of reach of
        // both `resolve.dedupe` and `vi.mock`. Inlining it sends its imports
        // of the peer dependencies above through Vitest's resolver. A pattern
        // rather than the package name, because once linked the core resolves
        // to its sibling directory, a path with no `node_modules/` segment to
        // match.
        inline: [/\/vintasend-templates-management-dashboard-core\//],
      },
    },

    // Radix dialogs, sheets and the debounced filter bars are slow to mount
    // under a loaded CI machine. The 5s default made whole suites flake
    // even though every assertion is deterministic.
    testTimeout: 20000,

    coverage: {
      provider: 'v8',
      // Coverage is measured over the dashboard's own code. `components/ui/**`
      // is deliberately absent: those are shadcn primitives generated by
      // `npx shadcn add`, replaced wholesale on regeneration, and already
      // covered indirectly wherever the app renders them.
      include: ['app/**/*.{ts,tsx}', 'lib/**/*.{ts,tsx}', 'proxy.ts'],
      exclude: [
        // Type-only modules: they compile away to nothing, so they would only
        // add noise to the report as empty files.
        'lib/auth/types.ts',
        '**/*.d.ts',
      ],
      thresholds: {
        statements: 85,
        branches: 72,
        functions: 75,
        lines: 85,
      },
    },
  },
});
